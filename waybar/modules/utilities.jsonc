{
  // Expandable menu left of the always-visible group: only the handle shows.
  // Clicking it opens the rest to its right, pushing the handle left.
  "group/utilities": {
    "orientation": "horizontal",
    "drawer": {
      "transition-duration": 400,
      "transition-left-to-right": true,
      "click-to-reveal": true,
      "children-class": "utility"
    },
    "modules": [
      "custom/utilities",
      "tray",
      "custom/keyboard-layout",
      "network",
      "backlight",
      "custom/notifications",
      "custom/weather"
    ]
  },
  // Always-visible utilities at the right edge.
  "group/status": {
    "orientation": "horizontal",
    "modules": [
      "battery",
      "pulseaudio#audio",
      "pulseaudio#microphone",
      "custom/power"
    ]
  },
  // on-click-release, not on-click: the press must reach the group to toggle it.
  "custom/utilities": {
    "exec": "~/.config/waybar/scripts/drawer.sh",
    "return-type": "json",
    "interval": "once",
    "signal": 11,
    "format": "<span font_family='lucide'>{icon}</span>",
    "format-icons": {
      "closed": "",
      "open": ""
    },
    "on-click-release": "~/.config/waybar/scripts/drawer.sh toggle",
    "cursor": true,
    "tooltip": false
  }
}
