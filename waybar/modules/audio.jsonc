{
  "pulseaudio#audio": {
    "format": "<span font_family='lucide'>{icon}</span>",
    "format-muted": "<span font_family='lucide'></span>",
    "format-icons": {
      "headphone": "",
      "default": ["", "", ""]
    },
    "scroll-step": 5,
    "on-click": "~/.config/wofi/audio-switcher.sh",
    "tooltip-format": "Volume: {volume}%"
  },
  "pulseaudio#microphone": {
    "format": "{format_source}",
    "format-source": "<span font_family='lucide'></span>",
    "format-source-muted": "<span font_family='lucide'></span>",
    "on-click": "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle",
    "tooltip": false
  }
}
