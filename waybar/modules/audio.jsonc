{
  "group/audio": {
    "orientation": "horizontal",
    "modules": [
      "pulseaudio#audio",
      "custom/separator",
      "pulseaudio#microphone"
    ]
  },
  "pulseaudio#audio": {
    "format": "{icon} {volume}%",
    "format-muted": "󰝟 Muted",
    "format-icons": {
      "headphone": "󰋋",
      "default": ["󰕿", "󰖀", "󰕾"]
    },
    "scroll-step": 5,
    "on-click": "~/.config/wofi/audio-switcher.sh",
    "tooltip-format": "Volume: {volume}%"
  },
  "pulseaudio#microphone": {
    "format": "{format_source}",
    "format-source": "󰍬",
    "format-source-muted": "󰍭",
    "on-click": "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle",
    "tooltip": false
  }
}
