{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "~/.config/fastfetch/logo_skull_small.txt",
    "color": {
        "1": "38;2;232;184;120",
        "2": "38;2;232;130;61",
        "3": "38;2;204;102;51",
        "4": "38;2;74;74;74",
        "5": "38;2;232;227;216",
        "6": "38;2;168;160;144"
      },
    "padding": { "right": 2 }
  },
  "display":{
    "pipe": false
  },

  "modules": [
    "title",
    "separator",
    "cpu",
    "gpu",
    "memory",
    "separator",
    "os",
    "kernel",
    "separator",
    "shell",
    "terminal"
  ]
}
